{
  "name": "veil",
  "version": "0.4.2",
  "author": "Dagim G. Astatkie",
  "type": "module",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@girs/gjs": "^5.6.0",
    "@girs/gnome-shell": "^51.0.1",
    "dotenv": "^17.4.2",
    "esbuild": "^0.25.9",
    "esbuild-plugin-tsc": "^0.5.0",
    "esbuild-preserve-whitespace": "^1.2.0",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "dev": "bun check && ./scripts/build.sh --build --unsafe-reload",
    "dev:nested": "bun build:install && env MUTTER_DEBUG_DUMMY_MODE_SPECS=1500x900 ./scripts/run-dev-session.sh",
    "ui": "./scripts/ui.sh",
    "build": "./scripts/build.sh --build",
    "build:install": "bun check && ./scripts/build.sh --build --install",
    "build:install:gdm": "bun check && ./scripts/build.sh --build --install --restart-gdm",
    "setup": "./scripts/setup.sh",
    "log": "./scripts/log.sh -f",
    "log:all": "./scripts/log.sh",
    "test": "bun test tests/unit",
    "test:vm": "./scripts/vm-test.sh",
    "test:docker": "VM_TARGET=docker ./scripts/vm-test.sh",
    "lint": "biome lint --write .",
    "lint:fix": "biome lint --write --unsafe .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check:types": "tsc -noEmit && bun scripts/check-no-any.js",
    "bump": "bun scripts/bump-version.js bump",
    "release": "bun scripts/bump-version.js release",
    "shexli": "shexli $(pwd)/dist"
  }
}
